{
  "name": "friendstack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:cards": "node --test tests/cards-*.test.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:load": "node scripts/test-cloud.mjs --load",
    "start:cloud": "node --env-file-if-exists=.env.local scripts/cloud-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "embedded-postgres": "^17.9.0-beta.16",
    "prettier": "^3.9.10"
  }
}
